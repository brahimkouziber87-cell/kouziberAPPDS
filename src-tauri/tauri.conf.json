{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kouziber Pedagogical Math Studio",
  "version": "1.0.0",
  "identifier": "com.kouziber.pedagogicalmath",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "منصة الهندسة البيداغوجية والتقويم التربوي - الرياضيات | Prof Kouziber Brahim",
        "width": 1440,
        "height": 920,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
